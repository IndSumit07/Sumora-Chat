{
  "name": "sumora-chat-server",
  "version": "1.0.0",
  "description": "Sumora Chat - Production-grade real-time chat server",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --experimental-specifier-resolution=node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart chatapp-server",
